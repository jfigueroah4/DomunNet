  "item": [
    {
      "name": "P-01: Autenticacion (Login y Obtencion de Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "var token = (jsonData.data && jsonData.data.token) ? jsonData.data.token : jsonData.token;",
              "if (token) {",
              "    pm.collectionVariables.set(\"token\", token);",
              "    console.log(\"Token guardado exitosamente:\", token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"daniel.figueroa@domunnet.test\",\n  \"contrasena\": \"mariobros25\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Inicia sesion con credenciales de administrador y extrae automaticamente el token JWT a las variables de coleccion."
      },
      "response": []
    },
    {
      "name": "P-02: Consultar Listado General de Proyectos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "var list = Array.isArray(jsonData.data) ? jsonData.data : (Array.isArray(jsonData) ? jsonData : []);",
              "if (list.length > 0) {",
              "    var target = list.find(function(p) { return p.estado === 'activo' || p.codigo === 'PROY-5916'; }) || list[0];",
              "    pm.collectionVariables.set(\"proyectoId\", target.id);",
              "    console.log(\"ID de Proyecto seleccionado:\", target.id, target.codigo);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/proyectos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "proyectos"
          ]
        },
        "description": "Consulta el listado general de proyectos activos y guarda el ID del proyecto para los siguientes pasos."
      },
      "response": []
    },
